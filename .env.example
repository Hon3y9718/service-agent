OPENAI_API_KEY =
GEMINI_API_KEY =
CLAUDE_API_KEY =
GROQ_API_KEY =
TOGETHER_API_KEY =

# Console HITL operator login. Generate a hash with:
#   python3 -c "import hashlib; print(hashlib.sha256(b'yourpassword').hexdigest())"
OPERATOR_USERNAME =
OPERATOR_PASSWORD_HASH =

# Per-session rate limit policy (week-0 decision)
RATE_LIMIT_MAX_REQUESTS = "20"
RATE_LIMIT_WINDOW_SECONDS = "300"

# Default company for callers that don't specify one (Telegram, a bare /chat call)
COMPANY_ID = "default"

# Postgres + pgvector connection for the knowledge store
DATABASE_URL = "postgresql://postgres:postgres@localhost:5432/cs"

# Shared secret required in the X-API-Key header for the FastAPI layer (machine-to-machine/
# Postman use; per-user web requests use the session login below instead)
API_KEY = "changeme-api-key"

# Signs web login session tokens (src/users.py). Generate one with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET_KEY =

# Telegram thin client: bot token for sending messages, and the secret_token registered
# with setWebhook (Telegram echoes it back as X-Telegram-Bot-Api-Secret-Token)
TELEGRAM_BOT_TOKEN =
TELEGRAM_WEBHOOK_SECRET =
